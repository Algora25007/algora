# Copy to infra/.env (git-ignored) and fill in. Never commit real values.

# Postgres password for the local docker-compose database.
POSTGRES_PASSWORD=change-me-local-only

# dev | test | prod. prod refuses the console email sender and the in-memory rate limiter.
ALGORA_ENV=dev

# At least 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORA_SECRET_KEY=

# Fernet key for TOTP secrets at rest. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALGORA_TOTP_ENCRYPTION_KEY=

# Set automatically by docker-compose; needed when running the API outside Docker.
# ALGORA_DATABASE_URL=postgresql+psycopg://algora:change-me-local-only@localhost:5432/algora
# ALGORA_REDIS_URL=redis://localhost:6379/0

# memory (single process) | redis (required in prod)
ALGORA_RATE_LIMIT_BACKEND=redis

# console prints sign-in codes to the API log (dev only) | smtp
ALGORA_EMAIL_BACKEND=console
# ALGORA_EMAIL_FROM=Algora <no-reply@your-domain>
# ALGORA_SMTP_HOST=
# ALGORA_SMTP_PORT=587
# ALGORA_SMTP_USERNAME=
# ALGORA_SMTP_PASSWORD=

# JSON list. The GitHub Pages site is the default; add http://localhost:8080 for local front-end work.
ALGORA_CORS_ORIGINS=["https://algora25007.github.io"]

# Only when the API runs behind a proxy you control that sets X-Forwarded-For.
ALGORA_TRUST_FORWARDED_FOR=false
